# ansible-lint configuration (https://docs.ansible.com/projects/lint/configuring/).
# The production profile is the strictest one. scripts/run_tests.sh (CI "ci / lint-test", "task
# test") and "task lint" run it from the repository root.
profile: production

# Lint with the collections of the hash-pinned "ansible" package (requirements-test.txt); never
# install anything from the network (ansible/requirements.yml names collections at git tags that
# CI does not fetch).
offline: true

# Roles of playbooks/site.yml that come from collections outside the "ansible" package
# (ansible/requirements.yml). Offline they are not installed, so ansible-lint treats them as
# present; their own repositories lint and test them. tests/test_playbooks.py keeps this list
# equal to the roles the playbooks use.
mock_roles:
  - luminare.gameserver.fxserver
  - luminare.gameserver.gameserver_observability
  - luminare.gameserver.txadmin
  - luminare.infra_edge.base
  - luminare.infra_edge.cloudflared
  - luminare.infra_edge.mariadb
  - luminare.infra_edge.nginx
  - luminare.infra_edge.restic_backup
  - prometheus.prometheus.prometheus

# ansible-lint 26.10.1 still lists ansible-core 2.15-2.19 as the supported releases for the
# meta-runtime rule; 2.20 and 2.21 are maintained releases too (ansible-core support matrix).
supported_ansible_also:
  - "2.20."
  - "2.21."

# Files that are not Ansible content, and caches, installed collections and build output.
exclude_paths:
  - .ansible/
  - .cache/
  - .github/
  - .venv/
  - ansible/collections/
  - dist/
  - docs/brand/
  - images/
  - secrets/
  - tests/fixtures/
  - tofu/
