# Python
__pycache__/
*.pyc
.venv/
# Release build output (scripts/package_release.py)
dist/
# Local tool installs
node_modules/
# Never commit environment files or server configs with keys
.env
.env.*
!.env.example
server.cfg

# Tool caches: go-task checksums, ansible-lint and Molecule
.task/
.ansible/

# OpenTofu: provider downloads, state and plan files. State belongs in the encrypted remote
# backend; a local state file or a saved plan can hold secrets in clear text.
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
*.tfplan.json
crash.log
crash.*.log
# Override files change a root module locally (for example backend_override.tf switches an
# environment to a local backend); they are never committed.
override.tf
override.tofu
*_override.tf
*_override.tofu
# Variable files of an environment hold its real account IDs, addresses and e-mail addresses;
# the values come from the SOPS files (TF_VAR_*) or from such a local file, never from git.
*.tfvars
*.tfvars.json

# Ansible inventories are generated from the OpenTofu outputs; collections are installed from
# ansible/requirements.yml into ansible/collections (ansible.cfg)
ansible/inventories/*/hosts.yml
ansible/collections/

# Secrets: in secrets/ only the README, examples and SOPS-encrypted dotenv files (*.enc.env)
# are committed. Decrypted copies never are, wherever they are written.
secrets/*
!secrets/README.md
!secrets/*.example
!secrets/*.enc.env
*.dec.*
*.decrypted.*
