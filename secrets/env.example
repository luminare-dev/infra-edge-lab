# Keys of an encrypted dotenv file (secrets/<env>.enc.env). Never fill in values here: create the
# real file with "sops edit secrets/<env>.enc.env" and keep each value on one line.
# An environment needs only the keys of the platforms it uses; the *-ci.enc.env files hold
# read-only tokens for the same keys.

# Proxmox VE API (bpg/proxmox provider): endpoint, API token, extra headers for an access proxy
PROXMOX_VE_ENDPOINT=
PROXMOX_VE_API_TOKEN=
PROXMOX_VE_API_HEADERS=

# Cloudflare API token limited to one zone (cloudflare/cloudflare provider), account and zone IDs,
# the zone itself, the Zero Trust team name, and the people who may log in to Access
# (a JSON list, for example ["operator@example.com"])
CLOUDFLARE_API_TOKEN=
TF_VAR_account_id=
TF_VAR_zone_id=
TF_VAR_zone=
TF_VAR_access_team_name=
TF_VAR_allowed_emails=

# Public SSH key(s) of the admin user: a JSON list for lab (TF_VAR_ssh_keys), one key line for
# demo and showcase (TF_VAR_ssh_public_key)
TF_VAR_ssh_keys=
TF_VAR_ssh_public_key=

# Hetzner Cloud API token of a project that holds nothing but this lab (hcloud provider)
HCLOUD_TOKEN=

# Remote state backend (S3-compatible object storage): the endpoint of the account, for example
# https://<account_id>.r2.cloudflarestorage.com, and the credentials of a token for the state
# bucket only
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Passphrase for state and plan encryption, at least 16 characters
TF_VAR_state_passphrase=
